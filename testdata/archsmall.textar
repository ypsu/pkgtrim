== /home/user/tricky_pkgtrim
somepkg1
# comment 1
somepkg2 somepkg3
# comment 2
# comment 3
some*kg4
!seq 5
some*kg5
trio*

!echo -e '# subprocess comment\nsubprocess_pkg'
!echo '!echo recursive_pkg'

# The removewithcfg tests remove fancyapp and otherapp.
# But fancylib and glibc should be still kept.
fancylib

